{
  "$schema": "https://code.claude.com/docs/settings-schema.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run setup)",
      "Bash(npm i *)",
      "Bash(npm install *)",
      "Bash(npx max *)"
    ],
    "deny": [
      "Bash(npm publish *)",
      "Bash(gh repo delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-push-to-main.cjs"
          }
        ]
      }
    ]
  }
}
